# Copy this file to ".env" and fill in your values. Never commit ".env".
PORT=5000
# From MongoDB Atlas: Connect > Drivers. Replace <db_password>, and add the database name /tradenova before the "?"
# Example: mongodb+srv://tradenova_user:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/tradenova?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxxx.mongodb.net/your_db_name
 
 
JWT_SECRET=change_this_to_a_long_random_string
# Set to false to disable live Yahoo Finance data and use simulated pricing
LIVE_DATA=true
